# Copy this file to `.env` and fill in your key.
# Get a Gemini API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# --- Optional overrides (defaults shown) ---
# Google retires model names often: gemini-1.5-* and gemini-2.0-* are shut down
# and return 404. gemini-2.5-flash is the current low-latency multimodal default.
# Run `python app.py --list-models` to see exactly what YOUR key can call.
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_API_VERSION=v1beta
